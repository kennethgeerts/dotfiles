theme = Nord

background-opacity = 0.9
background-blur = true
minimum-contrast = 3
faint-opacity = 0.85

font-family = Operator Mono SSm Lig
font-family-bold = Operator Mono SSm Lig
font-family-italic = Operator Mono SSm Lig
font-family-bold-italic = Operator Mono SSm Lig
font-style = Book
font-style-bold = Medium
font-style-italic = Book Italic
font-style-bold-italic = Medium Italic
font-size = 15
adjust-cell-width = -5%

cursor-style = block
cursor-style-blink = false

window-height = 34
window-width = 112
window-padding-x = 16
window-padding-y = 8
window-padding-balance = true

macos-icon = custom
macos-option-as-alt = true
macos-window-buttons = hidden
macos-titlebar-style = tabs

quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-animation-duration = 0.12

shell-integration-features = no-cursor,ssh-terminfo
keybind = global:cmd+escape=toggle_quick_terminal
