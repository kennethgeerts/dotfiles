#!/usr/bin/env zsh

set -e

echo "🔐 Please enter your password:"
sudo -v

# Keep sudo alive until the installer exits: waiting for the Xcode tools and
# brew bundle both outlast sudo's 5-minute timeout.
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

# Ask everything up front, so the rest of the install can run unattended.
# The git identity lives in ~/.gitconfig.local, outside the repo.
if [[ ! -f "$HOME/.gitconfig.local" ]]; then
  echo "👤 Who are you? (for git commits)"
  read "git_name?   Name: "
  read "git_email?   Email: "
fi

current_name="$(scutil --get ComputerName)"
read "computer_name?🖥️  Computer name [$current_name]: "
computer_name="${computer_name:-$current_name}"

echo "🖥️  Setting up system hostname..."
# LocalHostName and HostName only allow letters, digits and hyphens.
host_name="${${computer_name// /-}//[^A-Za-z0-9-]/}"
sudo scutil --set ComputerName "$computer_name"
sudo scutil --set HostName "$host_name"
sudo scutil --set LocalHostName "$host_name"
sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server NetBIOSName -string "$host_name"

echo "⌨️  Configuring keyboard settings..."
defaults write -g InitialKeyRepeat -int 10
defaults write -g KeyRepeat -int 1

echo "📱 Installing Xcode command line tools..."
if ! xcode-select -p &>/dev/null; then
  xcode-select --install
  echo "⏳ Waiting for Xcode command line tools installation to complete..."
  while ! xcode-select -p &>/dev/null; do
    sleep 5
  done
  echo "✅ Xcode command line tools installation complete!"
else
  echo "✅ Xcode command line tools already installed"
fi

if [[ -n "$git_name$git_email" ]]; then
  echo "👤 Saving git identity to ~/.gitconfig.local..."
  git config --file "$HOME/.gitconfig.local" user.name "$git_name"
  git config --file "$HOME/.gitconfig.local" user.email "$git_email"
fi

echo "📦 Cloning dotfiles repository..."
if [[ ! -d "$HOME/.dotfiles" ]]; then
  git clone https://github.com/kennethgeerts/dotfiles.git "$HOME/.dotfiles"
else
  echo "✅ Dotfiles repository already exists, skipping clone"
fi

cd "$HOME/.dotfiles"
echo "🍺 Installing Homebrew..."
if ! command -v brew &>/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

echo "⏳ Installing packages (this may take a while)..."
brew bundle --verbose

echo "🔗 Creating symlinks..."
mkdir -p "$HOME/.config" "$HOME/.local/bin" "$HOME/.zsh/cache"

link_into() {
  ln -sfn "$1" "$2/$(basename "$1")"
}

for file in "$HOME/.dotfiles/home"/*(ND.); do link_into "$file" "$HOME"; done
for bin in "$HOME/.dotfiles/bin"/*(ND.); do link_into "$bin" "$HOME/.local/bin"; done

# Apps write logs, sockets and state next to their config, so ~/.config/<app>
# is always a real directory: files are linked one by one, subdirectories
# (e.g. cliamp playlists, which cliamp saves by replacing the file) as a whole.
for dir in "$HOME/.dotfiles/config"/*(ND/); do
  target="$HOME/.config/$(basename "$dir")"
  [[ -L "$target" && "$(readlink "$target")" == "$HOME/.dotfiles/"* ]] && rm "$target"
  mkdir -p "$target"
  for file in "$dir"/*(ND.); do link_into "$file" "$target"; done
  for subdir in "$dir"/*(ND/); do
    subtarget="$target/$(basename "$subdir")"
    if [[ -d "$subtarget" && ! -L "$subtarget" ]]; then
      for file in "$subdir"/*(ND.); do link_into "$file" "$subtarget"; done
    else
      link_into "$subdir" "$target"
    fi
  done
done

echo "🧹 Pruning dead symlinks..."
for link in "$HOME"/.*(N@) "$HOME/.config"/**/*(ND@) "$HOME/.local/bin"/*(N@); do
  if [[ "$(readlink "$link")" == "$HOME/.dotfiles/"* && ! -e "$link" ]]; then
    rm "$link"
  fi
done

echo "📝 Setting up nvim..."
rm -rf "$HOME/.config/nvim"
git clone https://github.com/LazyVim/starter "$HOME/.config/nvim"
rm -rf "$HOME/.config/nvim/.git"
rm -rf "$HOME/.config/nvim/lua/plugins"
ln -s "$HOME/.dotfiles/nvim/lua/plugins" "$HOME/.config/nvim/lua/plugins"
nvim --headless "+Lazy! sync" +qa || true

echo "💎 Installing languages and dev CLIs with mise..."
mise install

echo ""
echo "🎉 Installation complete!"
