#!/bin/zsh

# Back up the credentials that stay out of git to two AES-256 encrypted zips
# with the same password: secrets-<ts>.zip for the ones in $HOME, and
# work-secrets-<ts>.zip for the ones in the repos under ~/Work. Paths are
# stored relative to $HOME. The second archive is restored after cloning, as
# git won't clone into a directory that already holds files:
#
#   cd ~ && 7z x /path/to/secrets-<ts>.zip        # SSH keys and the rest
#   # clone the repos into ~/Work, then:
#   cd ~ && 7z x /path/to/work-secrets-<ts>.zip

set -euo pipefail

secrets=(
  .ssh
  .aws/config
  .aws/credentials
  .netrc
  .config/rclone/rclone.conf
  .zshrc.local
  .gitconfig.local
)

dir="${${1:-$HOME/Desktop}:a}"
timestamp="$(date +%Y%m%d%H%M%S)"
archive="$dir/secrets-$timestamp.zip"
work_archive="$dir/work-secrets-$timestamp.zip"

if (( ! $+commands[7z] )); then
  print -u2 "7z is not installed or is not on PATH."
  exit 1
fi

if [[ ! -d "$dir" ]]; then
  print -u2 "Not a directory: $dir"
  exit 1
fi

# 7z adds to an existing archive instead of replacing it.
for existing in "$archive" "$work_archive"; do
  if [[ -e "$existing" ]]; then
    print -u2 "Archive already exists: $existing"
    exit 1
  fi
done

cd "$HOME"

found=()
for secret in $secrets; do
  if [[ -e "$secret" ]]; then
    found+=("$secret")
  else
    print -u2 "Skipping missing ~/$secret"
  fi
done

# Env files, Rails keys and Kamal secrets that aren't in their repo's git.
work_found=()
for repo in Work/*/.git(N/); do
  repo=${repo:h}
  for file in ${(f)"$(find "$repo" \
      \( -name .git -o -name node_modules -o -name .pnpm-store -o -name vendor -o -name tmp -o -path '*/.claude/worktrees' \) -prune -o \
      -type f \( -name '.env*' -o -path '*/config/master.key' -o -path '*/config/credentials/*.key' -o -path '*/.kamal/secrets*' \) -print)"}; do
    git -C "$repo" ls-files --error-unmatch -- "${file#$repo/}" &>/dev/null || work_found+=("$file")
  done
done

if (( ! $#found && ! $#work_found )); then
  print -u2 "No secrets found."
  exit 1
fi

read -rs 'password?Password: '; print
read -rs 'confirmation?Confirm password: '; print

if [[ -z "$password" ]]; then
  print -u2 "Password can't be empty."
  exit 1
fi

if [[ "$password" != "$confirmation" ]]; then
  print -u2 "Passwords don't match."
  exit 1
fi

# 7z reads a prompted password from the terminal rather than stdin, so pass it
# as an argument. It's visible in ps only while 7z runs.
zip_secrets() {
  local zip="$1"; shift
  (( $# )) || return 0

  7z a -tzip -mem=AES256 "-p$password" -bso0 -bsp0 \
    '-xr!.ssh/agent' '-xr!.DS_Store' \
    -- "$zip" "$@"

  chmod 600 "$zip"
  print "Backed up to $zip:"
  print -l -- "  ~/"${^@}
}

zip_secrets "$archive" $found
zip_secrets "$work_archive" $work_found
