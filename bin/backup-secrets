#!/bin/zsh

# Back up the credentials that stay out of the dotfiles to an AES-256 encrypted
# zip. Paths are stored relative to $HOME, so restoring on a new machine is:
#
#   cd ~ && 7z x /path/to/secrets.zip

set -euo pipefail

secrets=(
  .ssh
  .aws/config
  .aws/credentials
  .netrc
  .config/rclone/rclone.conf
  .zshrc.local
  .gitconfig.local
)

archive="${1:-$HOME/Desktop/secrets-$(date +%Y%m%d%H%M%S).zip}"
archive="${archive:a}"

if (( ! $+commands[7z] )); then
  print -u2 "7z is not installed or is not on PATH."
  exit 1
fi

# 7z adds to an existing archive instead of replacing it.
if [[ -e "$archive" ]]; then
  print -u2 "Archive already exists: $archive"
  exit 1
fi

cd "$HOME"

found=()
for secret in $secrets; do
  if [[ -e "$secret" ]]; then
    found+=("$secret")
  else
    print -u2 "Skipping missing ~/$secret"
  fi
done

if (( ! $#found )); then
  print -u2 "No secrets found."
  exit 1
fi

read -rs 'password?Password: '; print
read -rs 'confirmation?Confirm password: '; print

if [[ -z "$password" ]]; then
  print -u2 "Password can't be empty."
  exit 1
fi

if [[ "$password" != "$confirmation" ]]; then
  print -u2 "Passwords don't match."
  exit 1
fi

# 7z reads a prompted password from the terminal rather than stdin, so pass it
# as an argument. It's visible in ps only while 7z runs.
7z a -tzip -mem=AES256 "-p$password" -bso0 -bsp0 \
  '-xr!.ssh/agent' '-xr!.DS_Store' \
  -- "$archive" $found

chmod 600 "$archive"
print "Backed up ${(j:, :)found} to $archive"
